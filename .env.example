# ==============================================================================
# Variáveis de Ambiente da Infraestrutura do ProjetoIOT
# ==============================================================================
# Copie para .env (que não vai para o Git) e preencha os campos vazios:
#   cp .env.example .env
#
# Os campos de senha e token não têm valor padrão. Se algum ficar vazio,
# o "docker compose up" para com a mensagem "defina ... no .env".
#
# Para gerar valores aleatórios (na VM ou no Git Bash):
#   openssl rand -base64 24    # senhas
#   openssl rand -hex 32       # tokens e segredos
# No PowerShell:
#   [Convert]::ToBase64String((1..24 | ForEach-Object { Get-Random -Maximum 256 }))

# Domínio base para os serviços web (Node-RED e Grafana)
# Em ambiente local de desenvolvimento, utilize 'localhost'
# Em produção na VM, defina seu domínio ou DDNS (ex: iot.exemplo.com)
DOMAIN=localhost

# E-mail para emissão de certificados TLS automáticos no Caddy via Let's Encrypt / ZeroSSL
# Na VM, use um e-mail real: o Let's Encrypt recusa endereços @example.com.
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# Node-RED (T06 e T10, ver infra/nodered/settings.js)
# Senhas com pelo menos 12 caracteres. As duas senhas precisam ser diferentes.
# ------------------------------------------------------------------------------
# Login do editor (acesso total).
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_PASSWORD=
# Login dos nós "http in" e do dashboard (só visualização).
NODE_RED_HTTP_NODE_USER=viewer
NODE_RED_HTTP_NODE_PASSWORD=
# Cifra as credenciais salvas nos fluxos. Não troque depois de configurar os fluxos.
NODE_RED_CREDENTIAL_SECRET=

# ------------------------------------------------------------------------------
# Configurações do InfluxDB 2.x
# O setup só roda no primeiro boot (volume influxdb_data vazio). Trocar estes
# valores depois não muda a senha nem o token já gravados.
# ------------------------------------------------------------------------------
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
# Pelo menos 8 caracteres.
DOCKER_INFLUXDB_INIT_PASSWORD=
DOCKER_INFLUXDB_INIT_ORG=projetoiot
DOCKER_INFLUXDB_INIT_BUCKET=telemetria
DOCKER_INFLUXDB_INIT_RETENTION=30d
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=

# ------------------------------------------------------------------------------
# Configurações do Grafana
# Assim como no InfluxDB, a senha só vale na criação do volume grafana_data.
# ------------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# Mosquitto (T07)
# As senhas do MQTT (gateway-01, nodered, dev-mqttx) não ficam aqui: elas vão,
# com hash, para infra/mosquitto/config/passwd. Veja infra/mosquitto/config/passwd.example.
# ------------------------------------------------------------------------------
