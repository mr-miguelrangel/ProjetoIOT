# ==============================================================================
# Variáveis de Ambiente da Infraestrutura do ProjetoIOT
# ==============================================================================

# Domínio base para os serviços web (Node-RED e Grafana)
# Em ambiente local de desenvolvimento, utilize 'localhost'
# Em produção na VM, defina seu domínio ou DDNS (ex: iot.exemplo.com)
DOMAIN=localhost

# E-mail para emissão de certificados TLS automáticos no Caddy via Let's Encrypt / ZeroSSL
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# Configurações do InfluxDB 2.x
# ------------------------------------------------------------------------------
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=adminpassword123
DOCKER_INFLUXDB_INIT_ORG=projetoiot
DOCKER_INFLUXDB_INIT_BUCKET=telemetria
DOCKER_INFLUXDB_INIT_RETENTION=30d
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=my-super-secret-admin-token-12345

# ------------------------------------------------------------------------------
# Configurações do Grafana
# ------------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=adminpassword123

# ------------------------------------------------------------------------------
# Credenciais do Mosquitto MQTT (T07)
# ------------------------------------------------------------------------------
# Estas credenciais devem ser cadastradas no arquivo infra/mosquitto/config/passwd
# utilizando o utilitário 'mosquitto_passwd'.
MQTT_USER_GATEWAY=gateway-01
MQTT_PASS_GATEWAY=gatewaypassword123
MQTT_USER_NODRED=nodered
MQTT_PASS_NODRED=noderedpassword123
MQTT_USER_DEV=dev-mqttx
MQTT_PASS_DEV=devpassword123

# ------------------------------------------------------------------------------
# Segurança do Node-RED (T10)
# ------------------------------------------------------------------------------
# Chave mestra para encriptar senhas de nós (MQTT, InfluxDB) no flows_cred.json
NODE_RED_CREDENTIAL_SECRET=projetoiot-super-secret-key-change-me

# Credenciais do Editor (adminAuth)
NODE_RED_ADMIN_USER=admin
# Hash bcrypt (para gerar outro: docker run --rm -it nodered/node-red node-red-admin hash-pw)
NODE_RED_ADMIN_PASSWORD_HASH=$2b$08$0P/7fEGBU3W2xq52D6BtPe/9xxBQOp4lH22/xIbDBv3jOfT3EsURS

# Credenciais dos Endpoints HTTP e Dashboard (httpNodeAuth)
NODE_RED_HTTP_NODE_USER=viewer
NODE_RED_HTTP_NODE_PASSWORD_HASH=$2b$08$0P/7fEGBU3W2xq52D6BtPe/9xxBQOp4lH22/xIbDBv3jOfT3EsURS
