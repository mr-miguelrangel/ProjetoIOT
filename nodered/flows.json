    {
        "id": "fn_atraso",
        "type": "function",
        "z": "flow_idc",
        "name": "tempo desde a última leitura",
        "func": "// Calcula há quantos segundos cada nó enviou a última leitura\n// e gera o aviso de \"nó sem dados\" (> 60 s sem leituras).\nconst LIMITE_S = 60;\nconst saidas = [];\nconst semDados = [];\n\nfor (const no of ['no1', 'no2', 'no3']) {\n    const ultima = flow.get('ultima_' + no);\n    if (!ultima) {\n        saidas.push({ payload: 'nenhuma leitura recebida' });\n        semDados.push(no);\n        continue;\n    }\n    const s = Math.round((Date.now() - ultima) / 1000);\n    if (s > LIMITE_S) semDados.push(no);\n    saidas.push({ payload: (s > LIMITE_S ? '⚠ SEM DADOS - ' : '') + 'há ' + s + ' s' });\n}\n\nsaidas.push({\n    payload: semDados.length\n        ? '⚠ Nó sem dados (> ' + LIMITE_S + ' s): ' + semDados.join(', ')\n        : '✅ Todos os nós enviando dados'\n});\nreturn saidas;",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "outputLabels": ["no1", "no2", "no3", "aviso"],
        "x": 380,
        "y": 560,
        "wires": [["txt_no1"], ["txt_no2"], ["txt_no3"], ["txt_aviso"]]
    },
