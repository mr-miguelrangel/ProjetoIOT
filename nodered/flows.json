    {
        "id": "fn_consultas",
        "type": "function",
        "z": "flow_idc",
        "g": "grupo_banco",
        "name": "monta consultas",
        "func": "// Guarda o filtro escolhido e monta os parâmetros das consultas da página Histórico.\nif (msg.topic === 'no' || msg.topic === 'periodo') {\n    flow.set('hist_' + msg.topic, msg.payload);\n} else if (msg.payload?.page?.path !== '/historico') {\n    return null; // abriu outra página do dashboard\n}\n\nconst no = flow.get('hist_no') || 'todos';\nconst periodo = Number(flow.get('hist_periodo')) || 3600; // em segundos\nconst desde = new Date(Date.now() - periodo * 1000).toISOString();\n\nreturn [\n    { params: { $no: no, $desde: desde, $intervalo: periodo / 120 } }, // gráficos (~120 pontos por nó)\n    { params: { $no: no, $desde: desde } },                            // tabela\n    { params: {} }                                                     // total\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "outputLabels": ["gráficos", "tabela", "total"],
        "x": 600,
        "y": 1180,
        "wires": [["sql_grafico"], ["sql_tabela"], ["sql_total"]]
    },
    {
        "id": "sql_grafico",
        "type": "sqlite",
        "z": "flow_idc",
        "g": "grupo_banco",
        "mydb": "db_historico",
        "sqlquery": "prepared",
        "sql": "-- média por intervalo de tempo, por nó (x em ms, para o eixo de tempo)\nSELECT id_no,\n       (CAST(strftime('%s', recebido_em) AS INTEGER) / $intervalo) * $intervalo * 1000 AS x,\n       ROUND(AVG(temperatura), 1) AS temperatura,\n       ROUND(AVG(umidade), 1) AS umidade\nFROM leituras\nWHERE ($no = 'todos' OR id_no = $no) AND recebido_em >= $desde\nGROUP BY id_no, x\nORDER BY x;",
        "name": "consulta gráficos",
        "x": 830,
        "y": 1140,
        "wires": [["hist_temp", "hist_umid"]]
    },
    {
        "id": "sql_tabela",
        "type": "sqlite",
        "z": "flow_idc",
        "g": "grupo_banco",
        "mydb": "db_historico",
        "sqlquery": "prepared",
        "sql": "SELECT strftime('%d/%m/%Y %H:%M:%S', recebido_em, 'localtime') AS horario,\n       id_no, temperatura, umidade, rssi\nFROM leituras\nWHERE ($no = 'todos' OR id_no = $no) AND recebido_em >= $desde\nORDER BY recebido_em DESC\nLIMIT 50;",
