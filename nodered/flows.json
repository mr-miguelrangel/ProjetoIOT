    {
        "id": "sql_csv",
        "type": "sqlite",
        "z": "flow_idc",
        "g": "grupo_banco",
        "mydb": "db_historico",
        "sqlquery": "prepared",
        "sql": "SELECT id, id_no, temperatura, umidade, rssi, recebido_em\nFROM leituras\nWHERE ($no = 'todos' OR id_no = $no) AND recebido_em >= $desde\nORDER BY recebido_em;",
        "name": "consulta período",
        "x": 550,
        "y": 1380,
        "wires": [["fn_csv"]]
    },
    {
        "id": "fn_csv",
        "type": "function",
        "z": "flow_idc",
        "g": "grupo_banco",
        "name": "gera CSV",
        "func": "// Monta o CSV (cabeçalho + uma linha por leitura) e pede ao navegador para baixar o arquivo.\nconst colunas = ['id', 'id_no', 'temperatura', 'umidade', 'rssi', 'recebido_em'];\nconst linhas = msg.payload.map(r => colunas.map(c => r[c] ?? '').join(','));\nmsg.payload = [colunas.join(','), ...linhas].join('\\n') + '\\n';\nmsg.headers = {\n    'Content-Type': 'text/csv; charset=utf-8',\n    'Content-Disposition': 'attachment; filename=\"historico.csv\"'\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
