        "id": "fn_csv_filtro",
        "type": "function",
        "z": "flow_idc",
        "g": "grupo_banco",
        "name": "filtro atual",
        "func": "// Exporta o mesmo filtro escolhido na página Histórico.\nconst no = flow.get('hist_no') || 'todos';\nconst periodo = Number(flow.get('hist_periodo')) || 3600; // em segundos\nmsg.params = { $no: no, $desde: new Date(Date.now() - periodo * 1000).toISOString() };\nreturn msg;",
