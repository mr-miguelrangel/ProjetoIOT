    {
        "id": "com_grava",
        "type": "comment",
        "z": "flow_idc",
        "g": "grupo_banco",
        "name": "2. Valida cada leitura e grava (INSERT com parâmetros)",
        "info": "Leituras sem temperatura/umidade numéricas e mensagens com JSON inválido\nsão descartadas e aparecem no debug \"leituras descartadas\".",
        "x": 260,
        "y": 940,
