    {
        "id": "fn_valida",
        "type": "function",
        "z": "flow_idc",
        "g": "grupo_banco",
        "name": "valida leitura",
        "func": "// Só grava leituras com temperatura e umidade numéricas; o resto vai para o debug.\nconst p = msg.payload;\nconst valida = p !== null && typeof p === 'object'\n    && Number.isFinite(p.temperatura) && Number.isFinite(p.umidade);\n\nif (!valida) {\n    msg.motivo = 'leitura sem temperatura/umidade numéricas';\n    return [null, msg];\n}\n\nmsg.params = {\n    $id_no: msg.no,\n    $temperatura: p.temperatura,\n    $umidade: p.umidade,\n    $rssi: Number.isFinite(p.rssi) ? Math.round(p.rssi) : null,\n    $recebido_em: new Date(msg.recebido).toISOString()\n};\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "outputLabels": ["válida", "descartada"],
        "x": 140,
        "y": 980,
        "wires": [["sql_insere"], ["debug_descartadas"]]
    },
