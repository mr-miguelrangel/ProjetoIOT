        "z": "flow_idc",
        "name": "leituras dos nós",
        "topic": "idc/sensores/+/leituras",
        "qos": "0",
        "datatype": "json",
        "broker": "broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 140,
        "y": 100,
        "wires": [["fn_identifica"]]
    },
    {
        "id": "fn_identifica",
        "type": "function",
        "z": "flow_idc",
        "name": "identifica nó e horário",
        "func": "// Tópico: idc/sensores/<id>/leituras  ->  msg.no = <id>\nmsg.no = msg.topic.split('/')[2];\nmsg.recebido = Date.now();\nflow.set('ultima_' + msg.no, msg.recebido);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 100,
        "wires": [["sw_no", "graf_temp", "graf_umid", "debug_leituras", "fn_valida"]]
    },
